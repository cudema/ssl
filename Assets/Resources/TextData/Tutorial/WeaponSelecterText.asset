  m_Name: WeaponSelecterText
  m_EditorClassIdentifier: 
  strings:
  - "\uC7A0\uAE50, \uC124\uB9C8 \uADF8 \uC0C1\uD0DC\uB85C \uCD9C\uBC1C\uD560 \uAC74
    \uC544\uB2C8\uC8E0?"
  - "\uC5B8\uC81C\uAE4C\uC9C0\uACE0 \uB611\uAC19\uC740 \uBB34\uAE30\uB9CC \uC0AC\uC6A9\uD560
    \uC218\uB294 \uC5C6\uC73C\uB2C8\uAE4C\uC694.\n\uC81C\uAC8C \uC624\uC2DC\uBA74
    \uBB34\uAE30\uB97C \uBC14\uAFD4\uB4DC\uB9B4\uAC8C\uC694."
  - "\uADF8\uB807\uB2E4\uACE0 \uB611\uAC19\uC740 \uBB34\uAE30\uB97C \uB450\uAC1C
    \uB4E4 \uC218 \uC5C6\uB294\uAC74 \uC544\uC2DC\uC8E0?\n\uC774\uAC74 \uB2F9\uC5F0\uD55C
    \uAC70\uC5D0\uC694."
