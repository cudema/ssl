  m_Name: Tutorial3
  m_EditorClassIdentifier: 
  strings:
  - "\uC2E0\uBE44\uC758 \uC11D\uC0C1\uC740 \uB108\uC5D0\uAC8C \uC0C8\uB85C\uC6B4
    \uD798 '\uD2B9\uC131'\uC744 \uC904 \uAC83\uC774\uB2E4."
  - "\uD2B9\uC131\uC740 \uB2E8\uC21C\uD788 \uB108\uC758 \uD798\uC744 \uAC15\uD654\uD558\uB294
    \uAC83\uBD80\uD130 \uC0C8\uB85C\uC6B4 \uC804\uD22C\uB85C \uC774\uB044\uB294 \uB4F1
    \uB2E4\uC591\uD55C \uC885\uB958\uAC00 \uC788\uC9C0."
  - "\uC5BB\uC740 \uD2B9\uC131\uC744 \uC0AC\uC6A9\uD558\uB294 \uAC83\uC740 \uB124
    \uC790\uC720\uC9C0\uB9CC, \uBCF4\uC720\uD560 \uC218 \uC788\uB294 \uC218\uC5D0
    \uC81C\uD55C\uC774 \uC788\uC73C\uB2C8 \uC8FC\uC758\uD558\uB3C4\uB85D."
  - "\uCD5C\uB300\uB85C \uBCF4\uC720\uD560 \uC218 \uC788\uB294 \uC218\uB97C \uB118\uB294\uB2E4\uBA74
    \uAC00\uC9C0\uACE0 \uC788\uB358 \uD2B9\uC131\uACFC \uC0C8\uB85C\uC6B4 \uD2B9\uC131
    \uC911 \uD558\uB098\uB97C \uD3EC\uAE30\uD574\uC57C \uD55C\uB2E4.\n\uC2E0\uC911\uD788
    \uC120\uD0DD\uD558\uB3C4\uB85D."
