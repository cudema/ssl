  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: Tutorial1
  m_EditorClassIdentifier: 
  strings:
  - "\uC6C0\uC9C1\uC774\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294 \uC774\uACF3\uC5D0\uC11C
    \uC0B4\uC544\uB0A8\uC744 \uC218 \uC5C6\uACA0\uC9C0.\n\uACF5\uACA9\uD558\uB294
    \uBC95\uC744 \uC54C\uB824\uC8FC\uB9C8."
  - "\uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uC73C\uB85C \uBB34\uAE30\uB97C \uD718\uB450\uB974\uACE0,
    \uC6B0\uD074\uB9AD\uC73C\uB85C \uBCF4\uB2E4 \uAC15\uB825\uD55C \uC2A4\uD0AC\uC744
    \uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4.\n\uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD558\uBA74
    \uB124\uAC00 \uB4E4\uACE0 \uC788\uB294 \uBB34\uAE30 \uC911 \uB2E4\uB978 \uD558\uB098\uB85C
    \uAD50\uCCB4\uD558\uAC8C \uB418\uC9C0."
  - "\uC801\uC744 \uACF5\uACA9\uD558\uBA74 \uB124 \uBAB8\uC5D0 \uD798\uC774 \uCD95\uC801\uB420
    \uAC83\uC774\uB2E4."
  - "\uADF8 \uD798\uC774 \uAC00\uB4DD \uCC3C\uC744 \uB54C, \uC67C\uCABD Shift\uD0A4\uB97C
    \uB20C\uB7EC \uD798\uC744 \uD574\uBC29\uD574\uB77C.\n\uB450\uAC1C\uC758 \uBB34\uAE30\uB97C
    \uD568\uAED8 \uD718\uB458\uB7EC \uC801\uC744 \uC4F0\uB7EC\uD2B8\uB824\uB77C."
  - "\uB9C8\uCE68 \uC88B\uC740 \uC0C1\uB300\uAC00 \uB098\uD0C0\uB0AC\uAD70. \n\uC800
    \uB188\uC744 \uC6C0\uC9C1\uC774\uC9C0 \uBABB\uD558\uAC8C \uD560\uD14C\uB2C8 \uB124
    \uB9C8\uC74C\uB300\uB85C \uC800\uAC83\uC744 \uCC98\uCE58\uD574\uBCF4\uAC70\uB77C."
