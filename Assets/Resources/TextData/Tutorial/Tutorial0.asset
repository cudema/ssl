  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: Tutorial0
  m_EditorClassIdentifier: 
  strings:
  - "\uB4DC\uB514\uC5B4 \uAE68\uC5B4\uB0AC\uAD70. "
  - "\uC774\uACF3\uC740 \uC774\uCC28\uC6D0 \uBBF8\uAD81. \n\uC6D0\uB798\uB294 \uB0B4\uAC00
    \uC9C0\uBC30\uD558\uB358 \uACF5\uAC04\uC774\uC5C8\uC73C\uB098, \uAD18\uC538\uD55C
    \uAC83\uC774 \uACF5\uAC04\uC744 \uAE68\uD2B8\uB824 \uC774\uB7F0 \uBAA8\uC2B5\uC774
    \uB418\uC5C8\uB2E4."
  - "\uADF8 \uB188\uC740 \uC774 \uACF5\uAC04 \uB0B4\uBD80\uB85C \uC228\uC5B4\uB4E4\uC5C8\uB2E4.\n\uB0B4\uAC00
    \uB108\uB97C \uC77C\uC73C\uCF30\uC73C\uB2C8, \uB108\uB294 \uB098\uB97C \uB3C4\uC640
    \uC774 \uACF5\uAC04\uC744 \uB418\uCC3E\uACE0 \uCE69\uC785\uC790\uB97C \uBB3C\uB9AC\uCCD0\uC57C
    \uD55C\uB2E4."
  - "\uD558\uC9C0\uB9CC \uBB38\uC81C\uAC00 \uD558\uB098\uC788\uAD70.\n\uB188\uC744
    \uB530\uB77C \uB4E4\uC5B4\uC654\uC9C0\uB9CC \uC774\uBBF8 \uACF5\uAC04\uC740 \uC77C\uADF8\uB7EC\uC9C0\uACE0
    \uB4A4\uD2C0\uB838\uB2E4."
  - "\uC774\uACF3\uC5D0 \uC624\uB294 \uACFC\uC815\uC5D0\uC11C \uB108\uB294 \uB098\uC640
    \uB2E4\uB978 \uACF3\uC73C\uB85C \uC774\uB3D9\uB41C \uAC83 \uAC19\uAD6C\uB098."
  - "\uB9C8\uC6B0\uC2A4\uB97C \uC6C0\uC9C1\uC5EC \uC8FC\uBCC0\uC744 \uB458\uB7EC\uBCF4\uACE0,
    WASD\uB97C \uB20C\uB7EC \uC6C0\uC9C1\uC5EC\uB77C."
  - "\uC774\uAC83\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD558\uACA0\uC9C0.\nSpaceBar\uD0A4\uB97C
    \uB204\uB974\uBA74 \uC9E7\uC740 \uAC70\uB9AC\uB97C \uBE60\uB974\uAC8C \uC774\uB3D9\uD560
    \uC218 \uC788\uACE0, \uC801\uC758 \uACF5\uACA9\uC744 \uD68C\uD53C\uD560 \uC218 
    \uC788\uC744 \uAC83\uC774\uB2E4."
  - "\uC5B4\uC11C \uC6C0\uC9C1\uC5EC \uB0B4\uAC00 \uC788\uB294 \uACF3\uC73C\uB85C
    \uC624\uAC70\uB77C."
