  m_Name: Tutorial4
  m_EditorClassIdentifier: 
  strings:
  - "\uB108\uB97C \uC704\uD574 \uD2B9\uBCC4\uD55C \uB2A5\uB825\uC744 \uB0B4\uB824\uC8FC\uB9C8."
  - "C\uD0A4\uB85C \uCE90\uB9AD\uD130 \uC815\uBCF4, I\uD0A4\uB85C \uD2B9\uC131, M\uD0A4\uB85C
    \uC9C0\uB3C4\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "C\uD0A4\uB97C \uB20C\uB7EC \uB108\uC758 \uD604\uC7AC \uC0C1\uD0DC\uB97C \uD655\uC778\uD560
    \uC218 \uC788\uC744 \uAC83\uC774\uB2E4.\n\uB124\uAC00 \uC0AC\uC6A9\uC911\uC778
    \uBB34\uAE30\uC640 \uAC00\uC9C0\uACE0 \uC788\uB294 \uACE8\uB4DC\uB7C9\uC744 \uD655\uC778\uD560
    \uC218 \uC788\uC9C0."
  - "I\uD0A4\uB97C \uB204\uB974\uBA74 \uB124\uAC00 \uAC00\uC9C0\uACE0 \uC788\uB294
    \uD2B9\uC131\uC744 \uD655\uC778\uD560 \uC218 \uC788\uB2E4.\n\uD2B9\uC131\uC740
    \uB9C8\uC6B0\uC2A4\uB85C \uC6C0\uC9C1\uC77C \uC218 \uC788\uC73C\uB2C8 \uC798
    \uD65C\uC6A9\uD558\uB3C4\uB85D."
  - "M\uD0A4\uB97C \uB20C\uB7EC \uB124\uAC00 \uC704\uCE58\uD55C \uC774\uACF5\uAC04\uC758
    \uC9C0\uB3C4\uB97C \uBCFC \uC218 \uC788\uB2E4.\n\uB9C8\uC6B0\uC2A4\uB85C \uC9C0\uB3C4\uB97C
    \uC6C0\uC9C1\uC5EC \uBCFC \uC218 \uC788\uC73C\uB2C8 \uC54C\uC544\uB450\uB3C4\uB85D."
