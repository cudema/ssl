  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: Tutorial5
  m_EditorClassIdentifier: 
  strings:
  - "\uC774\uC804\uC5D0 \uC4F8\uB9CC\uD55C \uAC83\uB4E4 \uC5EC\uB7FF\uC744 \uB123\uC5B4\uB480\uB2E4\uACE0
    \uD588\uC5C8\uC9C0.\n\uC800 \uBAA8\uB2E5\uBD88\uB3C4 \uADF8 \uC911 \uD558\uB098\uB2E4."
  - "F\uD0A4\uB85C \uBAA8\uB2E5\uBD88\uC744 \uC0AC\uC6A9\uD558\uBA74 \uC18C\uBAA8\uB41C
    \uCCB4\uB825\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
  - "\uBB34\uC791\uC815 \uC774 \uACF5\uAC04\uC744 \uB5A0\uB3CC\uC9C0 \uC54A\uC544\uB3C4
    \uB41C\uB2E4.\n\uB124\uAC00 \uC774\uACF3\uC744 \uB3CC\uC544\uB2E4\uB2C8\uB294
    \uAC83\uC740 \uB0B4\uAC00 \uCE68\uC785\uC790\uC758 \uD754\uC801\uC744 \uCC3E\uC544\uB0B4\uAE30
    \uC704\uD568\uC774\uB2C8."
  - "\uB0B4\uAC00 \uADF8 \uB188\uC758 \uB9C8\uB825\uC744 \uCC3E\uAE30 \uAE4C\uC9C0
    \uC801\uB4E4\uC744 \uBB3C\uB9AC\uCE58\uACE0 \uBC29\uC744 \uB3CC\uD30C\uD574\uB77C."
  - "\uBC29 \uD558\uB098\uB97C \uB3CC\uD30C\uD560 \uB54C\uB9C8\uB2E4 \uB0B4\uAC00
    \uB188\uC758 \uB9C8\uB825\uC744 \uCC3E\uAE30 \uC26C\uC6CC\uC9C0\uACE0, \n\uC704\uCE58\uB97C
    \uCC3E\uAC8C \uB418\uBA74 \uAC15\uB825\uD55C \uD798\uC774 \uB290\uAEF4\uC9C0\uB294
    \uACF5\uAC04\uC73C\uB85C \uC5F0\uACB0\uB418\uB294 \uD3EC\uD0C8\uC744 \uC5F4 \uAC83\uC774\uB2E4."
  - "\uB0B4\uAC00 \uB9C8\uB825\uC744 \uCD94\uC801\uD558\uB294 \uC2DC\uAC04\uC774
    \uAD81\uAE08\uD558\uB2E4\uBA74 \uC6B0\uCE21 \uC704, \uC9C0\uB3C4 \uBAA8\uC11C\uB9AC\uB97C
    \uD655\uC778\uD558\uB3C4\uB85D.\n\uAE30\uC57D\uC5C6\uB294 \uBC29\uD669\uBCF4\uB2E8
    \uBAA9\uC801\uC774 \uC788\uB294\uAC8C \uB0AB\uACA0\uC9C0?"
  - "\uC774\uC81C \uB124 \uC704\uCE58\uB97C \uC54C\uC558\uB2E4. \uBAA8\uB2E5\uBD88\uC744
    \uC0AC\uC6A9\uD574\uB77C.\n\uC9C0\uAE08\uC740 \uB0B4\uAC00 \uC788\uB294 \uACF3\uC73C\uB85C
    \uC5F0\uACB0\uB41C \uD3EC\uD0C8\uC744 \uC5F4\uC5B4\uC8FC\uB9C8."
