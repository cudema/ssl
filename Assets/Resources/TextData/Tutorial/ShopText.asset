  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: ShopText
  m_EditorClassIdentifier: 
  strings:
  - "\uC544, \uC548\uB155\uD559\uC2ED\uB2C8\uAE4C!\n\uC774\uB7F0 \uACF3\uC5D0\uC11C
    \uB9CC\uB098\uB2E4\uB2C8 \uBCC4\uC77C\uC774\uAD70\uC694."
  - "\uC624, \uC9C4\uC815\uD558\uC2ED\uC2DC\uC624. \uC800\uB294 \uB2F9\uC2E0\uC758
    \uC801\uC774 \uC544\uB2C8\uB2C8\uAE4C\uC694.\n\uADF8\uB0E5 \uBB3C\uAC74\uC744
    \uD30C\uB294 \uC0C1\uC778\uC774\uB77C\uACE0 \uC0DD\uAC01\uD574\uC8FC\uC2DC\uC8E0."
  - "\uC804 \uB2F9\uC2E0\uC774 \uC0AC\uC6A9\uD558\uB294 '\uD2B9\uC131'\uC774\uB780
    \uAC83\uC744 \uB4DC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uADF8\uC800 \uC870\uAE08\uC758
    \uACE8\uB4DC\uB9CC \uC8FC\uC2DC\uBA74 \uBC14\uB85C \uB0B4\uC5B4\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uD639\uC5EC\uB098 \uD488\uBAA9\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC73C\uC2E0\uB2E4\uBA74...
    \uADF8\uB54C\uB3C4 \uACE8\uB4DC \uC870\uAE08\uC774\uBA74 \uB429\uB2C8\uB2E4.\n\uB2E4\uB9CC
    \uD488\uBAA9\uC744 \uBC14\uAFB8\uB294 \uAC83\uC740 \uC81C\uAC8C\uB3C4 \uBB34\uB9AC\uAC00
    \uB418\uB2C8 \uBC14\uAFC0\uB54C\uB9C8\uB2E4 \uC870\uAE08\uC529\uB9CC \uB354 \uBC1B\uACA0\uC2B5\uB2C8\uB2E4."
