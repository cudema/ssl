  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: SoulAdderText
  m_EditorClassIdentifier: 
  strings:
  - "\uB4DC\uB514\uC5B4 \uB3C4\uCC29\uD588\uAD70.\n\uC774\uACF3\uC774 \uC55E\uC73C\uB85C
    \uB124\uAC00 \uC0AC\uC6A9\uD560 \uAC70\uC810\uC774\uB2E4."
  - "\uB108\uB294 \uB0B4\uAC8C \uC801\uB4E4\uC758 \uC601\uD63C\uC744 \uBC14\uCCD0
    \uC2A4\uC2A4\uB85C\uB97C \uAC15\uD654\uD560 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4.\n\uD558\uC9C0\uB9CC
    \uC9C0\uAE08\uC740 \uBAA8\uC778 \uC601\uD63C\uC774 \uC5C6\uC744\uD14C\uB2C8 \uB2E4\uC74C\uC73C\uB85C
    \uB118\uC5B4\uAC00\uB3C4\uB85D \uD558\uC9C0."
  - "\uC55E\uC73C\uB85C \uB098\uC544\uAC00\uB77C. \uB098\uC758 \uC601\uAD11\uC744
    \uC704\uD574.\n...\uADF8\uB9AC\uACE0 \uB108\uC758 \uC790\uC720\uB97C \uC704\uD574."
