  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: Tutorial4
  m_EditorClassIdentifier: 
  strings:
  - "C\uD0A4\uB85C \uCE90\uB9AD\uD130 \uC815\uBCF4, I\uD0A4\uB85C \uD2B9\uC131, M\uD0A4\uB85C
    \uC9C0\uB3C4\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uCE90\uB9AD\uD130 \uC815\uBCF4\uC5D0\uC11C\uB294 \uD604\uC7AC \uC0AC\uC6A9\uC911\uC778
    \uBB34\uAE30, \uBCF4\uC720 \uC911\uC778 \uC7AC\uD654\uB7C9\uC744 \uD655\uC778\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD2B9\uC131\uC5D0\uC11C\uB294 \uC7A5\uCC29 \uC911\uC778 \uD2B9\uC131\uACFC
    \uBCF4\uAD00\uC911\uC778 \uD2B9\uC131\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC73C\uBA70,
    \uB4DC\uB798\uADF8\uB97C \uD1B5\uD574 \uD2B9\uC131\uC758 \uC704\uCE58\uB97C \uBCC0\uACBD\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC9C0\uB3C4\uC5D0\uC11C\uB294 \uD604\uC7AC \uC2A4\uD14C\uC774\uC9C0\uC758 \uC9C0\uB3C4\uB97C
    \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB4DC\uB798\uADF8\uB97C
    \uD1B5\uD574 \uC9C0\uB3C4\uB97C \uC6C0\uC9C1\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
