  m_Script: {fileID: 11500000, guid: 4a8efb7c5dfa2014a9a3ab809dc2a30d, type: 3}
  m_Name: Tutorial5
  m_EditorClassIdentifier: 
  strings:
  - "\uC2A4\uD14C\uC774\uC9C0\uB9C8\uB2E4 \uD134\uC774 \uC815\uD574\uC838 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD134\uC740 \uD558\uB098\uC758 \uBC29\uC744 \uD074\uB9AC\uC5B4\uD560 \uB54C\uB9C8\uB2E4
    \uAC10\uC18C\uD558\uBA70, \uD134\uC774 0\uC774 \uB410\uC744 \uACBD\uC6B0\uC5D0\uB294
    \uC5F0\uACB0\uB41C \uBC29\uC774 \uC0AC\uB77C\uC9C0\uBA70 \uBCF4\uC2A4\uB8F8\uC73C\uB85C
    \uD5A5\uD558\uB294 \uD3EC\uD0C8\uC774 \uC0DD\uC131\uB429\uB2C8\uB2E4."
  - "\uBCF4\uC2A4\uB8F8 \uD3EC\uD0C8\uACFC \uC0C1\uD638\uC791\uC6A9\uD558\uBA74 \uBCF4\uC2A4\uB8F8\uC73C\uB85C
    \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD29C\uD1A0\uB9AC\uC5BC \uAD6C\uAC04\uC5D0\uC11C\uB294 \uC2DC\uC791\uC758 \uBC29\uC73C\uB85C
    \uC774\uB3D9\uD558\uAC8C \uB429\uB2C8\uB2E4."
  - "\uBAA8\uB2E5\uBD88\uC744 \uC0AC\uC6A9\uD558\uC5EC \uCCB4\uB825\uC744 \uD68C\uBCF5\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uCCB4\uB825\uC744 \uD68C\uBCF5\uD558\uACE0 \uB2E4\uC74C\uC73C\uB85C \uB098\uC544\uAC00\uC138\uC694."
